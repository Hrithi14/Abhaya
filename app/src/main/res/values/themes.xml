<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme for the Activity window chrome only.
        Jetpack Compose draws its own UI — this theme just controls
        status bar / navigation bar colours while the app launches.
    -->
    <style name="Theme.Abhaya" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
